# Copy this file to .env.local and fill in your values.
# Never commit .env.local or any file containing real secrets.

# Required for the AI Assistant feature (POST /api/chat).
# Get a free key at: https://aistudio.google.com/apikey
# The app works fully without this key — only the AI Assistant panel is affected.
GEMINI_API_KEY="your_gemini_api_key_here"

# The URL where this app is hosted (used for OAuth callbacks in production).
# Leave as-is for local development.
APP_URL="http://localhost:3000"
