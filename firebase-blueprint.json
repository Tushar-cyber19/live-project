{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Public workspace profile metadata for a signed-in host.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "role": {
          "type": "string",
          "maxLength": 100
        },
        "timezone": {
          "type": "string",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "timezone", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "User Private Info",
      "description": "Isolated PII document storing the user's private email address.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "EventType": {
      "title": "Event Type",
      "description": "Reusable appointment template and buffer configuration.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "durationMinutes": {
          "type": "integer"
        },
        "location": {
          "type": "string",
          "enum": ["Google Meet", "Zoom", "Studio B · SF", "Phone Call"]
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "bufferMinutes": {
          "type": "integer"
        },
        "dailyLimit": {
          "type": "integer"
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "slug",
        "title",
        "durationMinutes",
        "location",
        "description",
        "bufferMinutes",
        "dailyLimit",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "Booking": {
      "title": "Booking",
      "description": "Scheduled appointment commitment belonging to a host user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "eventTypeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "startTime": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^\\d{2}:\\d{2}$"
        },
        "durationMinutes": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": ["confirmed", "pending", "cancelled"]
        },
        "clientName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "clientEmail": {
          "type": "string",
          "maxLength": 160
        },
        "clientCompany": {
          "type": "string",
          "maxLength": 100
        },
        "clientAvatar": {
          "type": "string",
          "maxLength": 300
        },
        "location": {
          "type": "string",
          "enum": ["Google Meet", "Zoom", "Studio B · SF", "Phone Call"]
        },
        "meetingUrl": {
          "type": "string",
          "maxLength": 300
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "title",
        "eventTypeId",
        "date",
        "startTime",
        "durationMinutes",
        "status",
        "clientName",
        "clientEmail",
        "clientCompany",
        "location",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "Persisted multi-turn scheduling assistant conversation message.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["user", "model"]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "modelUsed": {
          "type": "string",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "role", "text", "modelUsed", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Workspace profile for an authenticated user."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII storage for user email."
    },
    "/users/{userId}/eventTypes/{eventTypeId}": {
      "schema": { "$ref": "#/entities/EventType" },
      "description": "Event templates owned by the user."
    },
    "/users/{userId}/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Scheduled appointments owned by the user."
    },
    "/users/{userId}/chatMessages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Multi-turn assistant chat history owned by the user."
    }
  }
}
